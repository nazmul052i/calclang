// Numerical-Recipes-style algorithms in action: Brent's root finder,
// cubic spline interpolation, special functions (gamma / erf), and
// the Jacobi eigenvalue decomposition.
//
// Build:
//   build/calcnat examples/nr_demo.calc -o build/nr_demo.exe

import "nr.brent";
import "nr.spline";
import "nr.special";
import "nr.eigen";

// ===== Brent's method =====
print "===== Brent root finder =====";
// cos(x) = 0 on [0, π] -> π/2.
let cos_fn = fn(x) { return cos(x); };
print "cos(x) = 0 -> " + brent_root(cos_fn, 0, pi(), 0.0000000001, 100);
print "  exact  -> " + (pi() / 2);

// x³ - 2 = 0 -> cube root of 2.
let cubic = fn(x) { return x * x * x - 2; };
print "x^3 = 2  -> " + brent_root(cubic, 1, 2, 0.0000000001, 100);
print "  exact  -> " + pow(2, 1.0 / 3);

// e^x - 5 = 0 -> ln(5).
let expm5 = fn(x) { return exp(x) - 5; };
print "exp(x) = 5 -> " + brent_root(expm5, 0, 3, 0.0000000001, 100);
print "  exact   -> " + log(5);

// ===== Cubic spline =====
print "";
print "===== Cubic spline interpolation =====";
// Tabulate sin(x) at 7 knots over [0, 2π].
let xs = [];
let ys = [];
for i in 0..7 {
    let x = i / 6.0 * 2 * pi();
    push(xs, x);
    push(ys, sin(x));
}
let y2 = spline_setup(xs, ys);
// Compare interpolant vs exact at fine query points.
let max_err = 0;
for i in 0..100 {
    let x = i / 99.0 * 2 * pi();
    let err = abs(spline_eval(xs, ys, y2, x) - sin(x));
    if (err > max_err) { max_err = err; }
}
print "max spline error vs sin on [0, 2π] with 7 knots: " + max_err;
// At the knots, the spline must reproduce ys exactly.
print "at knot x=" + xs[3] + ":  spline=" + spline_eval(xs, ys, y2, xs[3]) + "  ys=" + ys[3];

// ===== Special functions =====
print "";
print "===== Special functions =====";
print "gamma(5)   = " + gamma(5)   + "   (exact: 24)";
print "gamma(0.5) = " + gamma(0.5) + "   (exact: sqrt(pi) = " + sqrt(pi()) + ")";
print "lgamma(10) = " + lgamma(10) + "  (exact: log(362880) = " + log(362880) + ")";
print "beta(2, 3) = " + beta(2, 3) + "   (exact: 1/12 = " + (1.0 / 12) + ")";
print "erf(0)     = " + erf(0)     + "   (exact: 0)";
print "erf(1)     = " + erf(1)     + "  (exact: 0.8427007929)";
print "erfc(2)    = " + erfc(2)    + "  (exact: 0.004677735)";

// ===== Jacobi eigenvalues =====
print "";
print "===== Jacobi eigenvalue decomposition =====";
// A simple symmetric matrix.
let A = [
    [4, 1, 2],
    [1, 3, 0],
    [2, 0, 5]
];
let eig = jacobi_eigen(A);
print "A:";
print A;
print "eigenvalues:";
print eig["values"];

// Verify: A * v_i = lambda_i * v_i for each i.
let V = eig["vectors"];
let n = 3;
for i in 0..n {
    // Extract column i as a vector.
    let v = [];
    for r in 0..n { push(v, V[r][i]); }
    // Compute A * v.
    let Av = [];
    for r in 0..n {
        let s = 0;
        for c in 0..n { s = s + A[r][c] * v[c]; }
        push(Av, s);
    }
    // Compute lambda * v.
    let lam = eig["values"][i];
    let lam_v = [];
    for r in 0..n { push(lam_v, lam * v[r]); }
    // Max residual.
    let resid = 0;
    for r in 0..n {
        let d = abs(Av[r] - lam_v[r]);
        if (d > resid) { resid = d; }
    }
    print "  eig " + i + ": lambda=" + lam + "  max |A v - lambda v| = " + resid;
}
