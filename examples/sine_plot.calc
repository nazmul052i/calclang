// Generate a sine wave and plot it to SVG.
//
// Build:
//   build/calcnat examples/sine_plot.calc -o build/sine_plot.exe
//   build/sine_plot.exe
//
// Output: build/sine.svg — open in any browser.

import "plot";

let xs = [];
let ys = [];
let two_pi = 2 * pi();

for (let i = 0; i < 400; i = i + 1) {
    let x = (i / 399.0) * 2 * two_pi;     // [0, 4π]
    push(xs, x);
    push(ys, sin(x));
}

plot_line("build/sine.svg", xs, ys, "sin(x) over [0, 4π]");
print "wrote build/sine.svg (" + len(xs) + " points)";
