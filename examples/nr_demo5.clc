// Tier-5 NR demo: QR + SVD + Laguerre poly roots + convolution.
//
// Build:
//   bin/clc examples/nr_demo5.clc -o build/nr_demo5.exe

import "nr.qr";
import "nr.svd";
import "nr.polyroots";
import "nr.conv";

// ===== QR decomposition / least squares =====
print "===== QR decomposition (Householder) =====";
let A = [[1, 1, 0],
         [1, 0, 1],
         [0, 1, 1],
         [1, 1, 1]];
let b = [3, 2, 4, 5];   // overdetermined 4 x 3
let qr = qr_decompose(A);
print "R (upper-triangular block):";
let R = qr["R"];
for i in 0..3 {
    let row = [];
    for j in 0..3 { push(row, R[i][j]); }
    print row;
}
let x_qr = qr_solve(qr, b);
print "least-squares solution:";
print x_qr;

// Residual ||A x - b||.
let r2 = 0;
for i in 0..4 {
    let s = 0;
    for j in 0..3 { s = s + A[i][j] * x_qr[j]; }
    r2 = r2 + (s - b[i]) * (s - b[i]);
}
print "||A x - b|| = " + sqrt(r2);

// ===== SVD =====
print "";
print "===== SVD =====";
let B = [[1, 2],
         [3, 4],
         [5, 6],
         [7, 8]];
let sv = svd(B);
print "singular values:";
print sv["S"];                       // expect ~ [14.27, 0.626]
print "right singular vectors (columns of V):";
print sv["V"];

// Solve the same LS system via SVD; should match QR.
let A2 = [[1, 1, 0],
          [1, 0, 1],
          [0, 1, 1],
          [1, 1, 1]];
let x_svd = svd_solve(A2, b);
print "SVD LS solution = ";  print x_svd;

// Pseudo-inverse times A should be ~ identity for a tall full-rank A.
let pinv = svd_pinv(A2);
let prod_zero = 0;
for i in 0..3 {
    for j in 0..3 {
        let s = 0;
        for k in 0..4 { s = s + pinv[i][k] * A2[k][j]; }
        let target = 0;  if (i == j) { target = 1; }
        let d = s - target;
        prod_zero = prod_zero + d * d;
    }
}
print "||A^+ A - I||_F = " + sqrt(prod_zero);

// ===== Laguerre polynomial roots =====
print "";
print "===== Polynomial roots (Laguerre's method) =====";

// P(x) = (x - 1)(x - 2)(x - 3) = x^3 - 6 x^2 + 11 x - 6.
// Coefficient convention: coefs[i] is the coefficient of x^i.
let p1 = [-6, 11, -6, 1];
let roots1 = poly_roots(p1);
print "roots of (x - 1)(x - 2)(x - 3):";
for i in 0..len(roots1) {
    print "  " + real(roots1[i]) + " + " + imag(roots1[i]) + "i";
}

// P(x) = x^2 + 1 — two complex roots ±i.
let p2 = [1, 0, 1];
let roots2 = poly_roots(p2);
print "roots of x^2 + 1:";
for i in 0..len(roots2) {
    print "  " + real(roots2[i]) + " + " + imag(roots2[i]) + "i";
}

// P(x) = x^4 - 1 — roots {1, -1, i, -i}.
let p3 = [-1, 0, 0, 0, 1];
let roots3 = poly_roots(p3);
print "roots of x^4 - 1:";
for i in 0..len(roots3) {
    print "  " + real(roots3[i]) + " + " + imag(roots3[i]) + "i";
}

// ===== Convolution =====
print "";
print "===== Convolution (direct vs FFT) =====";

// Convolve [1, 2, 3] with [1, 1, 1] -> [1, 3, 6, 5, 3].
let a = [1, 2, 3];
let bk = [1, 1, 1];
print "conv_direct =";   print conv_direct(a, bk);
print "conv_fft    =";   print conv_fft(a, bk);

// Correlation: identify a known kernel inside a signal. Place the
// kernel [1, 2, 3] inside a longer signal of zeros; the correlation
// should peak at the kernel's center.
let kernel = [1, 2, 3];
let sig = [0, 0, 0, 0, 1, 2, 3, 0, 0, 0];
let corr = correlate_fft(sig, kernel);
print "correlation (peak should be near index 4 + len(kernel) - 1 = 6):";
print corr;
let direct = corr_direct(sig, kernel);
print "corr_direct =";
print direct;
