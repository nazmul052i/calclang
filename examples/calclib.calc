// calclib: 48 functions baked into the VM. This example exercises a
// representative slice of math, strings, arrays, and I/O.

/* --- Math --- */
print "sqrt(2)   = " + to_str(sqrt(2));
print "pow(2,16) = " + to_str(pow(2, 16));
print "pi        = " + to_str(pi());
print "log10(1k) = " + to_str(log10(1000));
print "sin(pi/2) = " + to_str(sin(pi() / 2));

/* --- Strings --- */
let s = "  Hello, CalcLang World!  ";
print str_trim(s);
print str_upper(str_trim(s));
print str_lower(str_trim(s));
print "length = " + to_str(len(str_trim(s)));

let words = str_split(str_trim(s), " ");
print words;                                  // ["Hello,", "CalcLang", "World!"]
print str_join(words, " | ");                  // Hello, | CalcLang | World!

print str_starts_with("hello.txt", "hello");   // 1
print str_ends_with("hello.txt", ".txt");      // 1
print str_repeat("-", 30);                     // ------------------------------

/* --- Arrays --- */
// Build a list with array_range, transform, sort, slice.
let xs = array_range(1, 11);                   // [1..10]
print xs;
print "sum  = " + to_str(sum_arr(xs));
print "min  = " + to_str(min_arr(xs));
print "max  = " + to_str(max_arr(xs));

array_reverse(xs);
print "reversed: ";
print xs;

let shuffled = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3];
array_sort(shuffled);
print "sorted:   ";
print shuffled;
print "first 5:  ";
print array_slice(shuffled, 0, 5);

print "contains 9?  " + to_str(array_contains(shuffled, 9));
print "index of 5:  " + to_str(array_find(shuffled, 5));

/* --- write/print mixed --- */
write("[");
for (let i = 0; i < len(xs); i++) {
    if (i > 0) { write(", "); }
    write(to_str(xs[i]));
}
write("]");
print "";

/* --- type_of --- */
print type_of(42);          // num
print type_of("hi");        // str
print type_of([1, 2]);      // arr

// helper aggregations
fn sum_arr(a) {
    let acc = 0;
    for (let i = 0; i < len(a); i++) { acc += a[i]; }
    return acc;
}
fn min_arr(a) {
    let m = a[0];
    for (let i = 1; i < len(a); i++) { m = min(m, a[i]); }
    return m;
}
fn max_arr(a) {
    let m = a[0];
    for (let i = 1; i < len(a); i++) { m = max(m, a[i]); }
    return m;
}
