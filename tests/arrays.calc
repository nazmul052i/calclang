// Arrays: literals, indexing, mutation, len, push, reference semantics.

let a = [1, 2, 3];
print a;                                // [1, 2, 3]
print len(a);                           // 3
print a[0];                             // 1
print a[2];                             // 3

a[1] = 20;
print a;                                // [1, 20, 3]
print a[1];                             // 20

let empty = [];
print empty;                            // []
print len(empty);                       // 0

// Heterogeneous values.
let mixed = [42, "hi", 3.14];
print mixed;                            // [42, "hi", 3.14]
print mixed[1];                         // hi
print len(mixed);                       // 3

// push appends and returns the new length.
let n1 = push(mixed, "new");
print n1;                               // 4
print mixed;                            // [42, "hi", 3.14, "new"]

// push as a statement (call-as-statement, result is dropped).
push(mixed, "more");
print len(mixed);                       // 5

// Iterate with for.
let arr = [10, 20, 30, 40, 50];
let sum = 0;
for (let i = 0; i < len(arr); i++) {
    sum += arr[i];
}
print sum;                              // 150

// Reference semantics: aliasing shares storage.
let r = arr;
r[0] = 999;
print arr[0];                           // 999
print r[0];                             // 999

// Build a square table by pushing.
let squares = [];
for (let i = 1; i <= 5; i++) {
    push(squares, i * i);
}
print squares;                          // [1, 4, 9, 16, 25]

// Nested arrays and chained read.
let m = [[1, 2], [3, 4], [5, 6]];
print m;                                // [[1, 2], [3, 4], [5, 6]]
print m[1];                             // [3, 4]
print m[1][0];                          // 3

// Equality is reference identity.
let x = [1, 2];
let y = [1, 2];
let z = x;
if (x == z) { print 1; }                // 1
if (x == y) { print 99; } else { print 0; }   // 0
