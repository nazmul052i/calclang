// Allocates enough garbage to force several GC cycles. With the
// threshold at 256 KB and each iteration producing multiple objects,
// 50000 iterations exercises many collections. We verify that
// retained state (the running total + the survivor map + the
// captured closure cell) is intact across collections.

fn make_acc() {
    let total = 0;
    fn add(x) {
        total = total + x;
        return total;
    }
    return add;
}

let acc = make_acc();

let survivors = {};
survivors["sum"] = 0;
survivors["count"] = 0;

let last_str = "";

for (let i = 0; i < 50000; i = i + 1) {
    // Each iteration allocates: a string (via concat), an array, a
    // map, and updates two closures' captured cells. Most of these
    // become unreachable as soon as the next iteration starts.
    let s = "iter-" + to_str(i);
    let arr = [i, i * 2, i * 3, i + 1];
    let m = {"i": i, "label": s};
    last_str = s;
    acc(1);
    survivors["sum"] = survivors["sum"] + arr[1];
    survivors["count"] = survivors["count"] + 1;
}

// All these survivors must have lived through every collection.
print acc(0);                 // 50000  — total accumulated
print survivors["sum"];       // 2 + 4 + 6 + ... + 99998 = 50000 * 50000 - 50000 = 2499950000

// Wait: arr[1] = i*2 for i in 0..49999, so sum = 2 * (0+1+...+49999) = 2 * 49999*50000/2 = 49999*50000 = 2499950000
print survivors["count"];     // 50000
print last_str;               // iter-49999
print len(last_str);          // 10 (length of "iter-49999")

// The closure-captured `total` lived in a box that survived every GC.
// The map's items + keys + values + their internal buffers were all
// scanned correctly. The last_str global on the implicit main stack
// frame was rooted by conservative scan.
