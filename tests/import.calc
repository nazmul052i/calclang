// import.calc — verify `import "path";` projects pub fn signatures
// from a library into the current compilation unit, replacing the
// per-function `extern fn ...` declarations.

import "lib/math.calc";

print sq(7);              // 49
print cube(4);            // 64
print power_int(3, 5);    // 243
print cbrt(-8);           // -2
print hypot(3, 4);        // 5
print clamp(15, 0, 10);   // 10
print sign(-3.7);         // -1
print log2(1024);         // 10
