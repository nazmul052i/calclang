// Functions, for-loops, break, continue.

fn square(n) {
    return n * n;
}

fn add(a, b) {
    return a + b;
}

fn sum_to(n) {
    let acc = 0;
    for (let i = 1; i <= n; i = i + 1) {
        acc = acc + i;
    }
    return acc;
}

print square(7);             // 49
print add(2, 3);             // 5
print add(square(2), square(3));  // 4 + 9 = 13
print sum_to(10);            // 55

// for + break: count from 0, stop at 4.
for (let i = 0; i < 100; i = i + 1) {
    if (i == 4) { break; }
    print i;                 // 0 1 2 3
}

// for + continue: skip evens in 1..6.
for (let i = 1; i <= 6; i = i + 1) {
    if (i % 2 == 0) { continue; }
    print i;                 // 1 3 5
}

// nested loops: break only exits the inner one.
for (let r = 0; r < 2; r = r + 1) {
    for (let c = 0; c < 5; c = c + 1) {
        if (c == 2) { break; }
        print r * 10 + c;    // 0 1 10 11
    }
}

// Block scope check.
let s = 99;
{
    let s = 1;
    print s;                 // 1
}
print s;                     // 99
