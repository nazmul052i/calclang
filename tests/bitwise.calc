// bitwise.calc — bitwise operators + hex/binary literals.

// ===== Basic operators =====
print 5 & 3;            // 1
print 5 | 3;            // 7
print 5 ^ 3;            // 6
print ~5;               // -6
print 1 << 4;           // 16
print 256 >> 2;         // 64
print -8 >> 1;          // -4    (arithmetic shift, sign-extends)

// ===== Hex literals =====
print 0xFF;             // 255
print 0xff;             // 255
print 0xCAFE_BABE;      // 3405691582 (underscores are separators)

// ===== Binary literals =====
print 0b1010;           // 10
print 0b1111_0000;      // 240

// ===== Compound assignment =====
let x = 240;
x &= 51;                // 0xF0 & 0x33 = 0x30 = 48
print x;
x |= 5;                 // 53
print x;
x ^= 4;                 // 49
print x;
x <<= 2;                // 196
print x;
x >>= 1;                // 98
print x;

// ===== Precedence =====
print 1 + 2 << 3;       // (1+2)<<3 = 24
print 5 & 3 == 3;       // 5 & (3==3) = 5 & 1 = 1   (== tighter than &)
print 0xFF & 0x0F | 0x10;  // ((0xFF & 0x0F) | 0x10) = 31  (& tighter than |)
print ~0 & 0xFF;        // 255 (all ones of low byte)

// ===== Classic bit tricks =====
// Set / clear / toggle / test bit n
let f = 0;
f |= 1 << 3;            // set bit 3
print f;                // 8
f |= 1 << 5;            // set bit 5
print f;                // 40
print (f & (1 << 3)) != 0;   // 1 (bit 3 is set)
f &= ~(1 << 3);         // clear bit 3
print f;                // 32
f ^= 1 << 5;            // toggle bit 5
print f;                // 0

// Count low-set bits (popcount, naive)
fn popcount(n) {
    let c = 0;
    while (n != 0) {
        c = c + (n & 1);
        n = n >> 1;
    }
    return c;
}
print popcount(0xFF);   // 8
print popcount(0x55);   // 4
