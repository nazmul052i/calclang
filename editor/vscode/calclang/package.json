{
    "name": "calclang",
    "displayName": "CalcLang",
    "description": "Syntax highlighting, file icons, and editor support for CalcLang (.clc) and Calc assembly (.casm)",
    "version": "0.3.0",
    "publisher": "calclang-local",
    "engines": {
        "vscode": "^1.61.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "calclang",
                "aliases": ["CalcLang", "calclang"],
                "extensions": [".clc"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/clc.svg",
                    "dark":  "./icons/clc.svg"
                }
            },
            {
                "id": "calcasm",
                "aliases": ["CalcAsm", "calcasm"],
                "extensions": [".casm", ".co", ".cexe"],
                "configuration": "./casm-language-configuration.json",
                "icon": {
                    "light": "./icons/casm.svg",
                    "dark":  "./icons/casm.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "calclang",
                "scopeName": "source.clc",
                "path": "./syntaxes/clc.tmLanguage.json"
            },
            {
                "language": "calcasm",
                "scopeName": "source.casm",
                "path": "./syntaxes/casm.tmLanguage.json"
            }
        ]
    }
}
