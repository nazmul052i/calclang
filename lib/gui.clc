// gui.calc — small immediate-mode widget kit on top of the gui_*
// builtins. The widgets here aren't styled to match any OS theme —
// they're a flat, dark-friendly look meant to be readable in any
// terminal-like window setup. Customize colors via the helpers.

// =====================================================================
// Color packing
// =====================================================================

// A color is a struct of r/g/b — simpler than passing three nums
// around. All fields are 0..255.
pub struct Color { r: num, g: num, b: num }

// Convenience: build a Color from three components.
pub fn rgb(r, g, b) { return Color(r, g, b); }

// A few presets that read nicely in code.
pub fn col_dark()    { return Color(20, 22, 30); }
pub fn col_panel()   { return Color(30, 33, 45); }
pub fn col_text()    { return Color(220, 220, 220); }
pub fn col_accent()  { return Color(80, 180, 220); }
pub fn col_warn()    { return Color(220, 140, 50); }
pub fn col_error()   { return Color(220, 60, 80); }
pub fn col_ok()      { return Color(80, 200, 120); }

// Set the current draw color from a Color record.
pub fn gui_set(c) {
    gui_set_color(c.r, c.g, c.b);
}

// Clear the window with a Color.
pub fn gui_clear_c(c) {
    gui_clear(c.r, c.g, c.b);
}

// =====================================================================
// Filled / outlined rectangles using Color
// =====================================================================

pub fn gui_box(x, y, w, h, c) {
    gui_set_color(c.r, c.g, c.b);
    gui_rect(x, y, w, h);
}

pub fn gui_border(x, y, w, h, c) {
    gui_set_color(c.r, c.g, c.b);
    gui_rect_outline(x, y, w, h);
}

// Filled rect with a 1-px border on top — a "card" / panel look.
pub fn gui_card(x, y, w, h, fill, border) {
    gui_box(x, y, w, h, fill);
    gui_border(x, y, w - 1, h - 1, border);
}

// =====================================================================
// Immediate-mode button
// =====================================================================
//
// Returns 1 if the user clicked the button this frame, 0 otherwise.
// Highlights when hovered. The button has no internal state — the
// caller redraws it every frame and checks the return value.
//
//   if (button(20, 60, 120, 30, "Click me")) {
//       count = count + 1;
//   }

priv fn _in_rect(mx, my, x, y, w, h) {
    return mx >= x && mx < x + w && my >= y && my < y + h;
}

pub fn button(x, y, w, h, label) {
    let mx = gui_mouse_x();
    let my = gui_mouse_y();
    let hover = _in_rect(mx, my, x, y, w, h);
    let held  = hover && gui_mouse_down(0);
    let clicked = hover && gui_mouse_clicked(0);

    // Background tone shifts on hover and press.
    let bg = Color(50, 55, 70);
    if (hover) { bg = Color(70, 80, 105); }
    if (held)  { bg = Color(30, 35, 50); }
    gui_box(x, y, w, h, bg);
    gui_border(x, y, w - 1, h - 1, col_accent());

    // Center the label inside the button using the 8px-per-char metric
    // at scale 1. We pick the largest scale that still fits with some
    // padding, so a small button gets size-1 text and a tall one gets
    // bigger text automatically.
    let scale = 1;
    if (h >= 32) { scale = 2; }
    if (h >= 56) { scale = 3; }
    let cw = 8 * scale;
    let ch = 8 * scale;
    let text_w = len(label) * cw;
    let tx = x + floor((w - text_w) / 2);
    let ty = y + floor((h - ch) / 2);
    gui_set(col_text());
    gui_set_text_scale(scale);
    gui_text(tx, ty, label);
    return clicked;
}

// Plain label (text on its own — no background or border).
pub fn label(x, y, str) {
    gui_set(col_text());
    gui_set_text_scale(1);
    gui_text(x, y, str);
}

pub fn label_scaled(x, y, str, scale) {
    gui_set(col_text());
    gui_set_text_scale(scale);
    gui_text(x, y, str);
}

// =====================================================================
// Checkbox — small toggle with visible state
// =====================================================================

// Pass current state in; the return value is the new state.
pub fn checkbox(x, y, size, state) {
    let mx = gui_mouse_x();
    let my = gui_mouse_y();
    let hover = _in_rect(mx, my, x, y, size, size);
    let clicked = hover && gui_mouse_clicked(0);

    let bg = Color(40, 44, 58);
    if (hover) { bg = Color(60, 65, 85); }
    gui_box(x, y, size, size, bg);
    gui_border(x, y, size - 1, size - 1, col_accent());

    let s = state;
    if (clicked) {
        s = 1 - state;
    }
    if (s) {
        // A filled inner square indicates "on".
        let pad = 4;
        gui_box(x + pad, y + pad, size - 2 * pad, size - 2 * pad, col_accent());
    }
    return s;
}

// =====================================================================
// Slider — drag horizontally to set a value
// =====================================================================

// =====================================================================
// Text input — typing-editable single-line field
// =====================================================================
//
// Immediate-mode: caller passes the current string, the widget returns
// the (possibly mutated) string. Focus is tracked via gui_set_focus /
// gui_get_focus so the user can have multiple text fields and only the
// clicked-into one receives typed characters.
//
//   let name = "world";
//   while (!gui_should_close()) {
//       gui_poll_events();
//       name = text_input(20, 60, 200, 30, "name", name);
//       ...
//   }
//
// The `id` argument is a string that uniquely identifies this widget
// across the program. Used as the focus key — keep it stable per
// widget, distinct between widgets.
pub fn text_input(x, y, w, h, id, value) {
    let mx = gui_mouse_x();
    let my = gui_mouse_y();
    let in_box  = _in_rect(mx, my, x, y, w, h);
    let clicked = gui_mouse_clicked(0);

    // Click-to-focus, click-elsewhere-to-blur.
    if (clicked) {
        if (in_box) {
            gui_set_focus(id);
        } else if (gui_get_focus() == id) {
            gui_set_focus("");
        }
    }

    let focused = (gui_get_focus() == id);
    let new_value = value;
    if (focused) {
        // Backspace removes the last char.
        if (gui_key_pressed("backspace") && len(new_value) > 0) {
            new_value = str_slice(new_value, 0, len(new_value) - 1);
        }
        // Append whatever the user typed since the last frame.
        let typed = gui_text_typed();
        if (len(typed) > 0) {
            new_value = new_value + typed;
        }
        // Enter / Esc blurs.
        if (gui_key_pressed("enter") || gui_key_pressed("escape")) {
            gui_set_focus("");
        }
    }

    // Background + border (highlighted when focused).
    let bg = Color(35, 40, 55);
    if (focused) { bg = Color(45, 50, 70); }
    gui_box(x, y, w, h, bg);
    let bd = Color(60, 65, 85);
    if (focused) { bd = col_accent(); }
    gui_border(x, y, w - 1, h - 1, bd);

    // Render the value with a small left pad. Auto-pick scale: tall
    // boxes get bigger text, short ones get 1x.
    let scale = 1;
    if (h >= 32) { scale = 2; }
    let pad = 6;
    let glyph_w = 8 * scale;
    let glyph_h = 8 * scale;
    gui_set(col_text());
    gui_set_text_scale(scale);
    gui_text(x + pad, y + floor((h - glyph_h) / 2), new_value);

    // Blinking caret at the end of the text.
    if (focused) {
        let phase = floor(time_ms() / 500) % 2;
        if (phase == 0) {
            let cx = x + pad + len(new_value) * glyph_w;
            gui_box(cx, y + 4, 2, h - 8, col_text());
        }
    }
    return new_value;
}

// =====================================================================
// Dropdown — click to open, click an option to select
// =====================================================================
//
//   let opts = ["alpha", "beta", "gamma"];
//   choice = dropdown(20, 100, 200, 32, "choice", choice, opts);
//
// `current_idx` is the currently-selected index. Returns the new
// selection (same idx if nothing changed). The open/closed state lives
// in the focus registry — the dropdown is "open" iff gui_get_focus()
// matches its id. Clicking anywhere outside the open list closes it.
//
// Z-order tip: call this *last* in your frame so the open list panel
// draws on top of any other widgets it overlaps.
pub fn dropdown(x, y, w, h, id, current_idx, options) {
    let mx = gui_mouse_x();
    let my = gui_mouse_y();
    let clicked = gui_mouse_clicked(0);
    let on_button = _in_rect(mx, my, x, y, w, h);

    let opened = (gui_get_focus() == id);
    let new_idx = current_idx;

    if (clicked) {
        if (on_button) {
            // Toggle.
            if (opened) { gui_set_focus(""); opened = 0; }
            else        { gui_set_focus(id); opened = 1; }
        } else if (opened) {
            // Maybe clicked on an option?
            let n = len(options);
            let picked = -1;
            for i in 0..n {
                let oy = y + h + i * h;
                if (_in_rect(mx, my, x, oy, w, h)) {
                    picked = i;
                }
            }
            if (picked >= 0) {
                new_idx = picked;
            }
            // Click anywhere outside the button closes (whether or not
            // we picked something).
            gui_set_focus("");
            opened = 0;
        }
    }

    // Draw the closed-state button.
    let bg = Color(50, 55, 70);
    if (on_button) { bg = Color(70, 80, 105); }
    gui_box(x, y, w, h, bg);
    gui_border(x, y, w - 1, h - 1, col_accent());

    // Selected label.
    gui_set(col_text());
    gui_set_text_scale(1);
    gui_text(x + 8, y + floor((h - 8) / 2), options[current_idx]);

    // Down-caret marker on the right.
    let cy = y + floor(h / 2);
    gui_set(col_accent());
    gui_line(x + w - 16, cy - 3, x + w - 10, cy - 3);
    gui_line(x + w - 16, cy - 3, x + w - 13, cy);
    gui_line(x + w - 10, cy - 3, x + w - 13, cy);

    // Open-state panel: a stacked list of options.
    if (opened) {
        let n = len(options);
        let panel_h = n * h;
        gui_box(x, y + h, w, panel_h, Color(40, 44, 58));
        gui_border(x, y + h, w - 1, panel_h - 1, col_accent());
        for i in 0..n {
            let oy = y + h + i * h;
            let hov = _in_rect(mx, my, x, oy, w, h);
            if (hov) {
                gui_box(x + 1, oy + 1, w - 2, h - 2, Color(70, 80, 105));
            }
            if (i == current_idx) {
                gui_set(col_accent());
            } else {
                gui_set(col_text());
            }
            gui_text(x + 8, oy + floor((h - 8) / 2), options[i]);
        }
    }
    return new_idx;
}

// Slider — drag horizontally to set a value. Returns the new value
// (clamped to [lo, hi]).
pub fn slider(x, y, w, h, lo, hi, value) {
    let mx = gui_mouse_x();
    let my = gui_mouse_y();
    let hover = _in_rect(mx, my, x, y, w, h);
    let held  = hover && gui_mouse_down(0);

    let v = value;
    if (held) {
        // Linear map: mouse x within the slider rect -> [lo, hi].
        let t = (mx - x) / w;
        if (t < 0) { t = 0; }
        if (t > 1) { t = 1; }
        v = lo + t * (hi - lo);
    }

    // Track.
    gui_box(x, y + h / 2 - 2, w, 4, Color(50, 54, 70));
    // Filled portion.
    let frac = (v - lo) / (hi - lo);
    if (frac < 0) { frac = 0; }
    if (frac > 1) { frac = 1; }
    gui_box(x, y + h / 2 - 2, floor(w * frac), 4, col_accent());
    // Knob.
    let knob_x = x + floor(w * frac) - h / 2;
    gui_box(knob_x, y, h, h, col_text());

    return v;
}

// =====================================================================
// Scrollable region — clip + offset
// =====================================================================
//
// Used to display content larger than its visible box. The caller draws
// the content with y values offset by scroll_y, framed between calls to
// scroll_begin and scroll_end. The shared focus registry holds the
// scroll position keyed by id so multiple regions on screen don't fight.
//
//   scroll_begin(x, y, w, h);
//   // draw content at (y - scroll_y) etc.
//   scroll_end();

pub fn scroll_begin(x, y, w, h) {
    gui_set_clip(x, y, w, h);
}

pub fn scroll_end() {
    gui_clear_clip();
}

// Draw a vertical scrollbar on the right edge of (x, y, w, h) showing
// current scroll position. Returns the (possibly mutated) scroll_y
// (clamped to [0, content_h - h]).
//
// Drag the thumb with the left mouse button to scroll. Click on the
// track jumps to that position.
pub fn scrollbar(x, y, w, h, content_h, scroll_y) {
    let max_y = content_h - h;
    if (max_y < 0) { max_y = 0; }
    let new_y = scroll_y;
    if (new_y < 0)     { new_y = 0; }
    if (new_y > max_y) { new_y = max_y; }
    if (max_y == 0) {
        // Nothing to scroll — draw nothing.
        return new_y;
    }

    let bar_w = 10;
    let bx = x + w - bar_w;
    gui_box(bx, y, bar_w, h, Color(35, 38, 52));
    let thumb_h = floor(h * h / content_h);
    if (thumb_h < 24) { thumb_h = 24; }
    if (thumb_h > h)  { thumb_h = h; }
    let thumb_y = y + floor((h - thumb_h) * new_y / max_y);

    let mx = gui_mouse_x();
    let my = gui_mouse_y();
    let held = gui_mouse_down(0);
    if (held && _in_rect(mx, my, bx, y, bar_w, h)) {
        // Jump to wherever the mouse is along the bar.
        let frac = (my - y - thumb_h / 2) / (h - thumb_h);
        if (frac < 0) { frac = 0; }
        if (frac > 1) { frac = 1; }
        new_y = floor(max_y * frac);
        thumb_y = y + floor((h - thumb_h) * new_y / max_y);
    }
    gui_box(bx + 1, thumb_y, bar_w - 2, thumb_h, col_accent());
    return new_y;
}

// =====================================================================
// Table / data grid
// =====================================================================
//
//   let headers = ["Name", "Age", "City"];
//   let rows = [["Alice", 30, "NYC"], ["Bob", 24, "SF"], ...];
//   let scroll_y = table(x, y, w, h, headers, rows, scroll_y);
//
// Returns the new scroll position. Column widths are equal-split
// across w; pass an explicit col_widths array via table_ex for
// uneven layouts.

priv fn _table_cell_to_str(cell) {
    return "" + cell;
}

pub fn table(x, y, w, h, headers, rows, scroll_y) {
    let n_cols = len(headers);
    if (n_cols == 0) { return scroll_y; }
    let cw = floor((w - 12) / n_cols);   // leave space for scrollbar
    let header_h = 24;
    let row_h = 22;

    // Header row.
    gui_box(x, y, w, header_h, Color(45, 50, 70));
    gui_set(col_text());
    gui_set_text_scale(1);
    for c in 0..n_cols {
        gui_text(x + c * cw + 6, y + 8, headers[c]);
    }

    // Vertical column separators (over the header).
    for c in 1..n_cols {
        gui_set(Color(60, 65, 85));
        gui_line(x + c * cw, y, x + c * cw, y + header_h);
    }

    // Body — scrollable.
    let body_y = y + header_h;
    let body_h = h - header_h;
    let n_rows = len(rows);
    let content_h = n_rows * row_h;

    scroll_begin(x, body_y, w - 12, body_h);
    for r in 0..n_rows {
        let ry = body_y + r * row_h - scroll_y;
        if (ry + row_h < body_y) { continue; }
        if (ry > body_y + body_h) { break; }
        let bg = Color(30, 33, 45);
        if (r % 2 == 1) { bg = Color(35, 38, 52); }
        gui_box(x, ry, w - 12, row_h, bg);
        gui_set(col_text());
        gui_set_text_scale(1);
        let row = rows[r];
        for c in 0..n_cols {
            let s = _table_cell_to_str(row[c]);
            gui_text(x + c * cw + 6, ry + 7, s);
        }
    }
    scroll_end();

    gui_border(x, y, w - 1, h - 1, Color(60, 65, 85));

    // Right-hand scrollbar.
    let new_scroll_y = scrollbar(x, body_y, w, body_h, content_h, scroll_y);
    return new_scroll_y;
}

// =====================================================================
// XY plot — line chart with axes + labels
// =====================================================================
//
//   plot_xy(x, y, w, h, xs, ys, title);
//
// `xs` and `ys` are parallel arrays. Auto-scales axes to the data
// range; draws a 1px line through the points. Title (string) is
// rendered at the top-left of the plot box.

pub fn plot_xy(x, y, w, h, xs, ys, title) {
    let n = len(xs);
    if (n == 0 || len(ys) != n) {
        gui_box(x, y, w, h, Color(28, 30, 42));
        gui_border(x, y, w - 1, h - 1, Color(60, 65, 85));
        return;
    }

    // Data range.
    let xmin = xs[0]; let xmax = xs[0];
    let ymin = ys[0]; let ymax = ys[0];
    for i in 1..n {
        if (xs[i] < xmin) { xmin = xs[i]; }
        if (xs[i] > xmax) { xmax = xs[i]; }
        if (ys[i] < ymin) { ymin = ys[i]; }
        if (ys[i] > ymax) { ymax = ys[i]; }
    }
    if (xmax == xmin) { xmax = xmin + 1; }
    if (ymax == ymin) { ymax = ymin + 1; }

    // Outer frame.
    gui_box(x, y, w, h, Color(28, 30, 42));
    gui_border(x, y, w - 1, h - 1, Color(60, 65, 85));

    // Title.
    if (len(title) > 0) {
        gui_set(col_text());
        gui_set_text_scale(1);
        gui_text(x + 8, y + 6, title);
    }

    // Plot area (inset for axes + labels).
    let pad_l = 56;
    let pad_r = 12;
    let pad_t = 24;
    let pad_b = 24;
    let px = x + pad_l;
    let py = y + pad_t;
    let pw = w - pad_l - pad_r;
    let ph = h - pad_t - pad_b;
    gui_box(px, py, pw, ph, Color(20, 22, 30));
    gui_border(px, py, pw - 1, ph - 1, Color(70, 80, 105));

    // Light grid: 4 horizontal + 4 vertical lines.
    gui_set(Color(34, 36, 50));
    for i in 1..4 {
        let gy = py + floor(ph * i / 4);
        gui_line(px, gy, px + pw, gy);
        let gx = px + floor(pw * i / 4);
        gui_line(gx, py, gx, py + ph);
    }

    // Axis labels (extents — keep it simple).
    gui_set(col_text());
    gui_set_text_scale(1);
    gui_text(x + 4, y + pad_t,                "" + ymax);
    gui_text(x + 4, y + h - pad_b - 8,        "" + ymin);
    gui_text(x + pad_l,            y + h - 12, "" + xmin);
    gui_text(x + w - pad_r - 56,   y + h - 12, "" + xmax);

    // The line itself.
    gui_set(col_accent());
    gui_set_clip(px, py, pw, ph);
    let prev_sx = 0; let prev_sy = 0;
    for i in 0..n {
        let sx = px + floor((xs[i] - xmin) / (xmax - xmin) * pw);
        let sy = py + ph - floor((ys[i] - ymin) / (ymax - ymin) * ph);
        if (i > 0) {
            gui_line(prev_sx, prev_sy, sx, sy);
        }
        prev_sx = sx;
        prev_sy = sy;
    }
    gui_clear_clip();
}

// =====================================================================
// Menu bar
// =====================================================================
//
//   let mb_state = menubar(0, 0, win_w, ["File", "Edit", "Help"], mb_state);
//
// Renders a row of clickable menu items along the top of the window.
// Returns the index of the currently-active menu, or -1 if none.
// Pass the previous return value back in to track open/closed state.
//
// The menu dropdowns themselves are NOT drawn by this function — the
// caller looks at the returned index and draws whatever menu they
// want. The menubar widget just owns the top strip.

pub fn menubar(x, y, w, items, active) {
    let n = len(items);
    let h = 24;
    let item_w = 88;

    gui_box(x, y, w, h, Color(30, 33, 45));
    gui_set(Color(50, 55, 70));
    gui_line(x, y + h, x + w, y + h);

    let mx = gui_mouse_x();
    let my = gui_mouse_y();
    let clicked = gui_mouse_clicked(0);
    let new_active = active;

    for i in 0..n {
        let ix = x + i * item_w;
        let hov = _in_rect(mx, my, ix, y, item_w, h);
        if (hov || i == active) {
            gui_box(ix, y, item_w, h, Color(60, 70, 95));
        }
        if (clicked && hov) {
            if (i == active) { new_active = -1; } else { new_active = i; }
        }
        gui_set(col_text());
        gui_set_text_scale(1);
        gui_text(ix + 10, y + 8, items[i]);
    }
    // Click outside the bar AND we're open? close.
    if (clicked && !_in_rect(mx, my, x, y, w, h) && active >= 0) {
        new_active = -1;
    }
    return new_active;
}

// Render a menu's dropdown list under the menu-bar item at index `idx`.
// Returns the index of the chosen item (0-based in `items`), or -1 if
// nothing was picked this frame. Caller should reset the menubar
// active state to -1 after a pick.
pub fn menu_dropdown(x, y, idx, items) {
    let n = len(items);
    let item_w = 160;
    let item_h = 22;
    let menu_x = x + idx * 88;
    let menu_y = y + 24;
    gui_box(menu_x, menu_y, item_w, n * item_h + 4, Color(40, 44, 58));
    gui_border(menu_x, menu_y, item_w - 1, n * item_h + 3, col_accent());

    let mx = gui_mouse_x();
    let my = gui_mouse_y();
    let clicked = gui_mouse_clicked(0);
    let picked = -1;
    for i in 0..n {
        let iy = menu_y + 2 + i * item_h;
        let hov = _in_rect(mx, my, menu_x, iy, item_w, item_h);
        if (hov) {
            gui_box(menu_x + 1, iy, item_w - 2, item_h, Color(60, 70, 95));
        }
        gui_set(col_text());
        gui_set_text_scale(1);
        gui_text(menu_x + 10, iy + 7, items[i]);
        if (clicked && hov) {
            picked = i;
        }
    }
    return picked;
}
