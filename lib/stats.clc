// stats.clc — basic statistics for flat arrays of numbers.
// Build: calcnat --lib lib/stats.clc -o build/stats.s

pub fn sum_of(xs) {
    let s = 0;
    for i in 0..len(xs) {
        s = s + xs[i];
    }
    return s;
}

pub fn mean(xs) {
    if (len(xs) == 0) { throw "mean: empty array"; }
    return sum_of(xs) / len(xs);
}

pub fn variance(xs) {
    if (len(xs) < 2) { throw "variance: need at least 2 values"; }
    let m = mean(xs);
    let s = 0;
    for i in 0..len(xs) {
        let d = xs[i] - m;
        s = s + d * d;
    }
    // Sample variance — divide by (n-1).
    return s / (len(xs) - 1);
}

pub fn stddev(xs) {
    return sqrt(variance(xs));
}

pub fn min_of(xs) {
    if (len(xs) == 0) { throw "min_of: empty array"; }
    let m = xs[0];
    for i in 1..len(xs) {
        if (xs[i] < m) { m = xs[i]; }
    }
    return m;
}

pub fn max_of(xs) {
    if (len(xs) == 0) { throw "max_of: empty array"; }
    let m = xs[0];
    for i in 1..len(xs) {
        if (xs[i] > m) { m = xs[i]; }
    }
    return m;
}

// Range — max - min.
pub fn range_of(xs) {
    return max_of(xs) - min_of(xs);
}

// Median by sorting a copy.
pub fn median(xs) {
    if (len(xs) == 0) { throw "median: empty array"; }
    let copy = array_concat(xs, []);
    array_sort(copy);
    let n = len(copy);
    if (n % 2 == 1) {
        return copy[(n - 1) / 2];
    }
    return (copy[n / 2 - 1] + copy[n / 2]) / 2;
}

// Pearson correlation coefficient between xs and ys.
pub fn correlate(xs, ys) {
    if (len(xs) != len(ys)) { throw "correlate: length mismatch"; }
    if (len(xs) < 2) { throw "correlate: need at least 2 pairs"; }
    let n = len(xs);
    let mx = mean(xs);
    let my = mean(ys);
    let num = 0;
    let sx = 0;
    let sy = 0;
    for i in 0..n {
        let dx = xs[i] - mx;
        let dy = ys[i] - my;
        num = num + dx * dy;
        sx  = sx  + dx * dx;
        sy  = sy  + dy * dy;
    }
    let denom = sqrt(sx * sy);
    if (denom == 0) { return 0; }
    return num / denom;
}

// Result of `linreg`. A typed record — access fields with dot syntax:
//   let fit = linreg(xs, ys);
//   print fit.slope;     fit.intercept;     fit.r2;
pub struct LinReg {
    slope: num,
    intercept: num,
    r2: num,
}

// Simple least-squares linear regression: y = slope * x + intercept.
// `r2` is the coefficient of determination (between 0 and 1; 1 = perfect fit).
pub fn linreg(xs, ys) {
    if (len(xs) != len(ys)) { throw "linreg: length mismatch"; }
    if (len(xs) < 2) { throw "linreg: need at least 2 points"; }
    let n = len(xs);
    let mx = mean(xs);
    let my = mean(ys);
    let num = 0;
    let den = 0;
    for i in 0..n {
        num = num + (xs[i] - mx) * (ys[i] - my);
        den = den + (xs[i] - mx) * (xs[i] - mx);
    }
    if (den == 0) { throw "linreg: x has zero variance"; }
    let slope     = num / den;
    let intercept = my - slope * mx;
    // r² as 1 - SS_res / SS_tot.
    let ss_res = 0;
    let ss_tot = 0;
    for i in 0..n {
        let pred = slope * xs[i] + intercept;
        let resid = ys[i] - pred;
        let dev   = ys[i] - my;
        ss_res = ss_res + resid * resid;
        ss_tot = ss_tot + dev   * dev;
    }
    let r2 = 0;
    if (ss_tot != 0) { r2 = 1 - ss_res / ss_tot; }
    return LinReg(slope, intercept, r2);
}

// Histogram: count values falling into n_bins equal-width bins
// covering [min, max]. Returns {"edges": [...], "counts": [...]}.
pub fn histogram(xs, n_bins) {
    if (len(xs) == 0) { throw "histogram: empty array"; }
    let lo = min_of(xs);
    let hi = max_of(xs);
    if (hi == lo) { hi = lo + 1; }   // avoid zero-width
    let width = (hi - lo) / n_bins;
    let edges = [];
    for i in 0..=n_bins {
        push(edges, lo + i * width);
    }
    let counts = [];
    for i in 0..n_bins { push(counts, 0); }
    for i in 0..len(xs) {
        let bin = floor((xs[i] - lo) / width);
        if (bin < 0) { bin = 0; }
        if (bin >= n_bins) { bin = n_bins - 1; }
        counts[bin] = counts[bin] + 1;
    }
    return {"edges": edges, "counts": counts};
}

// =====================================================================
// Reductions / scans — round out the Fortran-intrinsic set.
// =====================================================================

// Argmin / argmax — index of the minimum / maximum element.
pub fn argmin(xs) {
    if (len(xs) == 0) { throw "argmin: empty array"; }
    let best = 0;
    for i in 1..len(xs) {
        if (xs[i] < xs[best]) { best = i; }
    }
    return best;
}

pub fn argmax(xs) {
    if (len(xs) == 0) { throw "argmax: empty array"; }
    let best = 0;
    for i in 1..len(xs) {
        if (xs[i] > xs[best]) { best = i; }
    }
    return best;
}

// Cumulative sum: cumsum([1,2,3,4]) -> [1, 3, 6, 10].
pub fn cumsum(xs) {
    let out = [];
    let s = 0;
    for x in xs {
        s = s + x;
        push(out, s);
    }
    return out;
}

// Cumulative product.
pub fn cumprod(xs) {
    let out = [];
    let p = 1;
    for x in xs {
        p = p * x;
        push(out, p);
    }
    return out;
}

// First-differences: diff([1, 3, 6, 10]) -> [2, 3, 4]. Output is one
// shorter than input.
pub fn diff(xs) {
    let out = [];
    for i in 1..len(xs) {
        push(out, xs[i] - xs[i - 1]);
    }
    return out;
}

// Percentile via linear interpolation between order statistics.
// `p` is 0..100. Sorts a copy of xs so the original is untouched.
pub fn percentile(xs, p) {
    if (len(xs) == 0) { throw "percentile: empty array"; }
    if (p < 0 || p > 100) { throw "percentile: p must be 0..100"; }
    let sorted = array_sort(array_concat([], xs));
    let n = len(sorted);
    if (n == 1) { return sorted[0]; }
    let pos = (p / 100) * (n - 1);
    let lo = floor(pos);
    let hi = lo + 1;
    if (hi >= n) { return sorted[n - 1]; }
    let frac = pos - lo;
    return sorted[lo] + frac * (sorted[hi] - sorted[lo]);
}

pub fn quartiles(xs) {
    return {
        "q1": percentile(xs, 25),
        "q2": percentile(xs, 50),
        "q3": percentile(xs, 75),
    };
}

// Covariance (unbiased, n-1 denominator).
pub fn covariance(xs, ys) {
    if (len(xs) != len(ys)) { throw "covariance: length mismatch"; }
    if (len(xs) < 2)        { throw "covariance: need at least 2 points"; }
    let mx = mean(xs);
    let my = mean(ys);
    let s = 0;
    for i in 0..len(xs) {
        s = s + (xs[i] - mx) * (ys[i] - my);
    }
    return s / (len(xs) - 1);
}

pub fn coeff_variation(xs) {
    let m = mean(xs);
    if (m == 0) { throw "coeff_variation: mean is zero"; }
    return stddev(xs) / m;
}

// Standard error of the mean.
pub fn sem(xs) {
    return stddev(xs) / sqrt(len(xs));
}

// Z-scores: (x - mean) / stddev for every element.
pub fn zscore(xs) {
    let m = mean(xs);
    let s = stddev(xs);
    if (s == 0) { throw "zscore: zero variance"; }
    let out = [];
    for x in xs { push(out, (x - m) / s); }
    return out;
}

// Min-max normalization to [0, 1].
pub fn normalize(xs) {
    let lo = min_of(xs);
    let hi = max_of(xs);
    if (hi == lo) { throw "normalize: constant data"; }
    let out = [];
    for x in xs { push(out, (x - lo) / (hi - lo)); }
    return out;
}
