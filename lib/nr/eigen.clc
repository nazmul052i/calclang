// eigen.clc — Jacobi eigenvalue decomposition for real symmetric
// matrices.
//
// Each iteration finds the largest off-diagonal element, rotates it
// to zero with a Givens-like 2×2 plane rotation, and accumulates the
// rotations into V. The product converges to the full eigenvector
// matrix; the diagonal of the rotated matrix converges to the
// eigenvalues.
//
// O(n³) per sweep, O(log(1/eps)) sweeps. Solid for small-to-medium
// symmetric problems (a few hundred). Not the right tool for huge
// matrices.
//
// Returns {"values": [v0, v1, ...], "vectors": V}, where V is an
// n×n matrix whose i-th COLUMN is the eigenvector for values[i].
//
// Reference: Numerical Recipes 11.1.

priv fn _mat_copy(m) {
    let n = len(m);
    let out = [];
    for i in 0..n {
        let row = [];
        for j in 0..len(m[i]) { push(row, m[i][j]); }
        push(out, row);
    }
    return out;
}

priv fn _mat_zero(n) {
    let m = [];
    for i in 0..n {
        let row = [];
        for j in 0..n { push(row, 0); }
        push(m, row);
    }
    return m;
}

pub fn jacobi_eigen(a_in) {
    let n = len(a_in);
    if (n == 0 || len(a_in[0]) != n) { throw "jacobi_eigen: A must be square"; }
    // Working copy of A and accumulating V (start as identity).
    let a = _mat_copy(a_in);
    let v = _mat_zero(n);
    for i in 0..n { v[i][i] = 1; }

    let max_sweeps = 50;
    for sweep in 0..max_sweeps {
        // Sum of off-diagonal magnitudes; if tiny we're converged.
        let off = 0;
        for i in 0..n {
            for j in i + 1..n {
                off = off + abs(a[i][j]);
            }
        }
        if (off < 1e-12) {
            // Extract eigenvalues from the diagonal.
            let values = [];
            for i in 0..n { push(values, a[i][i]); }
            return {"values": values, "vectors": v};
        }
        // Iterate over upper-triangular off-diagonals.
        for p in 0..n - 1 {
            for q in p + 1..n {
                let apq = a[p][q];
                if (abs(apq) < 1e-14) { continue; }
                let app = a[p][p];
                let aqq = a[q][q];
                // Compute the rotation angle.
                let theta = (aqq - app) / (2 * apq);
                let t = 0;
                if (abs(theta) > 1e16) {
                    t = 1 / (2 * theta);
                } else {
                    // sign(theta) / (|theta| + sqrt(theta^2 + 1))
                    let sgn = 1; if (theta < 0) { sgn = -1; }
                    t = sgn / (abs(theta) + sqrt(theta * theta + 1));
                }
                let c = 1 / sqrt(t * t + 1);
                let s = t * c;
                // Update A in place. Off-diagonal a[p][q] becomes zero.
                a[p][p] = app - t * apq;
                a[q][q] = aqq + t * apq;
                a[p][q] = 0;
                a[q][p] = 0;
                // Rotate rows / columns r != p, q.
                for r in 0..n {
                    if (r == p || r == q) { continue; }
                    let arp = a[r][p];
                    let arq = a[r][q];
                    a[r][p] = c * arp - s * arq;
                    a[r][q] = s * arp + c * arq;
                    a[p][r] = a[r][p];
                    a[q][r] = a[r][q];
                }
                // Accumulate into V.
                for r in 0..n {
                    let vrp = v[r][p];
                    let vrq = v[r][q];
                    v[r][p] = c * vrp - s * vrq;
                    v[r][q] = s * vrp + c * vrq;
                }
            }
        }
    }
    throw "jacobi_eigen: didn't converge within max_sweeps";
}
