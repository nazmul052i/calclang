// spline.calc — natural cubic spline interpolation.
//
// Two-step interface in the Numerical Recipes style:
//
//   let y2 = spline_setup(xs, ys);
//   // y2 is the array of second derivatives at each knot.
//   // Compute it once; reuse for every interpolation query.
//
//   let y_at = spline_eval(xs, ys, y2, x);
//
// xs MUST be strictly ascending. spline_setup uses the "natural"
// boundary condition (y''(x0) = y''(x_{n-1}) = 0), which makes the
// spline as straight as possible at the endpoints.
//
// Reference: Numerical Recipes 3.3.

// Returns an array of second derivatives at xs[i].
pub fn spline_setup(xs, ys) {
    let n = len(xs);
    if (n < 2)            { throw "spline_setup: need at least 2 points"; }
    if (n != len(ys))     { throw "spline_setup: xs/ys length mismatch"; }
    let y2 = [];
    let u  = [];
    for (let i = 0; i < n; i = i + 1) { push(y2, 0); push(u, 0); }
    // Natural boundary at the left endpoint.
    y2[0] = 0;
    u[0]  = 0;
    // Tridiagonal sweep (Thomas algorithm).
    for (let i = 1; i < n - 1; i = i + 1) {
        let sig = (xs[i] - xs[i - 1]) / (xs[i + 1] - xs[i - 1]);
        let p   = sig * y2[i - 1] + 2;
        y2[i] = (sig - 1) / p;
        let dy_r = (ys[i + 1] - ys[i])     / (xs[i + 1] - xs[i]);
        let dy_l = (ys[i]     - ys[i - 1]) / (xs[i]     - xs[i - 1]);
        u[i]    = (6 * (dy_r - dy_l) / (xs[i + 1] - xs[i - 1]) - sig * u[i - 1]) / p;
    }
    // Natural boundary at the right endpoint.
    y2[n - 1] = 0;
    // Back-substitute.
    for (let k = n - 2; k >= 0; k = k - 1) {
        y2[k] = y2[k] * y2[k + 1] + u[k];
    }
    return y2;
}

// Evaluate the spline at x. Linear-search bracket; for sorted-query
// access patterns the caller can keep a hint, but this is fine for
// modest data sizes.
pub fn spline_eval(xs, ys, y2, x) {
    let n = len(xs);
    if (n < 2) { throw "spline_eval: need at least 2 points"; }
    // Clamp queries outside the data range to the endpoint values
    // (matches NR's behavior; alternative is to extrapolate).
    if (x <= xs[0])     { return ys[0]; }
    if (x >= xs[n - 1]) { return ys[n - 1]; }
    // Binary search for the bracket.
    let lo = 0;
    let hi = n - 1;
    while (hi - lo > 1) {
        let mid = floor((lo + hi) / 2);
        if (xs[mid] > x) { hi = mid; } else { lo = mid; }
    }
    let h = xs[hi] - xs[lo];
    if (h == 0) { throw "spline_eval: duplicate xs values"; }
    let a = (xs[hi] - x) / h;
    let b = (x - xs[lo]) / h;
    return a * ys[lo] + b * ys[hi]
         + ((a * a * a - a) * y2[lo] + (b * b * b - b) * y2[hi]) * (h * h) / 6;
}
