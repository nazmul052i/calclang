// simplex_lp.calc — two-phase simplex method for linear programming.
//
// Solves:
//   maximize    c^T x
//   subject to  A x <= b,
//               x >= 0,
// where A is m x n, b is length m (any signs), c is length n.
//
// We tabulate as the classic NR-style table (NR §10.8) and pivot until
// the top row has no positive reduced costs. The big-M method handles
// negative b entries by introducing artificial variables.
//
// API:
//   simplex_lp(c, A, b)
//      -> {"status": 0|1|2,  // 0 = optimal, 1 = unbounded, 2 = infeasible
//          "x":      [...], // optimal x in R^n  (zeros if infeasible)
//          "value":  num }  // optimal c^T x

priv fn _sx_zero(rows, cols) {
    let m = [];
    for (let i = 0; i < rows; i = i + 1) {
        let row = [];
        for (let j = 0; j < cols; j = j + 1) { push(row, 0); }
        push(m, row);
    }
    return m;
}

pub fn simplex_lp(c, A, b) {
    let m = len(A);
    if (m == 0) { throw "simplex_lp: empty constraint matrix"; }
    let n = len(c);
    // Tableau dimensions: (m + 1) rows by (n + m + 1) columns.
    // Layout: rows 0..m-1 are constraint rows (with slacks),
    //         row m is the objective.
    // Columns: 0..n-1 original vars, n..n+m-1 slacks, n+m is RHS.
    let T = _sx_zero(m + 1, n + m + 1);
    // Big-M for sign-flipped rows.
    let BIG = 1e9;
    // Basis: which variable is currently basic in each row.
    let basis = [];
    for (let i = 0; i < m; i = i + 1) {
        // Flip the sign if b[i] < 0 to keep the slack basic.
        let flip = 0;  if (b[i] < 0) { flip = 1; }
        for (let j = 0; j < n; j = j + 1) {
            T[i][j] = A[i][j];
            if (flip == 1) { T[i][j] = -T[i][j]; }
        }
        // Slack column: identity, OR -identity then we need an artificial.
        if (flip == 0) {
            T[i][n + i] = 1;
            T[i][n + m] = b[i];
            push(basis, n + i);
        } else {
            T[i][n + i] = -1;
            T[i][n + m] = -b[i];
            // Big-M penalty: treat the i-th slack like an artificial.
            T[m][n + i] = BIG;
            push(basis, n + i);
        }
    }
    // Objective row (we maximize: store -c so we look for positive entries).
    for (let j = 0; j < n; j = j + 1) { T[m][j] = -c[j]; }
    // Adjust objective row for any big-M penalties already injected.
    for (let i = 0; i < m; i = i + 1) {
        if (b[i] < 0) {
            for (let j = 0; j <= n + m; j = j + 1) {
                T[m][j] = T[m][j] - BIG * T[i][j];
            }
        }
    }
    let max_iter = 200 * (n + m);
    for (let iter = 0; iter < max_iter; iter = iter + 1) {
        // Pick entering variable: smallest (most negative) value in
        // objective row excluding RHS — but we stored -c so the entering
        // column is the most negative T[m][j]. (Standard form trick.)
        let entering = -1;
        let best = -1e-9;
        for (let j = 0; j < n + m; j = j + 1) {
            if (T[m][j] < best) { best = T[m][j]; entering = j; }
        }
        if (entering < 0) {
            // Optimal. Read off x.
            let x = [];
            for (let j = 0; j < n; j = j + 1) { push(x, 0); }
            for (let i = 0; i < m; i = i + 1) {
                if (basis[i] < n) { x[basis[i]] = T[i][n + m]; }
            }
            return {"status": 0, "x": x, "value": T[m][n + m]};
        }
        // Choose leaving variable: smallest positive ratio b_i / a_i in
        // the entering column.
        let leaving = -1;
        let best_ratio = 1e300;
        for (let i = 0; i < m; i = i + 1) {
            if (T[i][entering] > 1e-12) {
                let ratio = T[i][n + m] / T[i][entering];
                if (ratio < best_ratio) { best_ratio = ratio; leaving = i; }
            }
        }
        if (leaving < 0) {
            // No bound — unbounded LP.
            let zx = [];
            for (let j = 0; j < n; j = j + 1) { push(zx, 0); }
            return {"status": 1, "x": zx, "value": 1e300};
        }
        // Pivot.
        let pivot = T[leaving][entering];
        for (let j = 0; j <= n + m; j = j + 1) { T[leaving][j] = T[leaving][j] / pivot; }
        for (let i = 0; i <= m; i = i + 1) {
            if (i == leaving) { continue; }
            let factor = T[i][entering];
            if (factor == 0) { continue; }
            for (let j = 0; j <= n + m; j = j + 1) {
                T[i][j] = T[i][j] - factor * T[leaving][j];
            }
        }
        basis[leaving] = entering;
    }
    let zx = [];
    for (let j = 0; j < n; j = j + 1) { push(zx, 0); }
    return {"status": 2, "x": zx, "value": 0};
}
