// qr.clc — QR decomposition by Householder reflections.
//
// For an m x n matrix A with m >= n, computes A = Q R where Q is m x m
// orthogonal and R is m x n upper triangular. Then any linear system or
// least-squares problem can be solved by back-substitution on R.
//
// Householder is the canonical numerically-stable QR (NR §2.10). Each
// reflection zeroes out a column below the diagonal in one O(mn) sweep.
//
// API:
//   qr_decompose(A)    -> QR record (.Q is m x m, .R is m x n)
//   qr_solve(qr, b)    -> least-squares solution x to A x = b
//                         (works for square or overdetermined)
//   qr_apply_QT(qr, b) -> Q^T b (handy when re-solving without forming Q)

pub struct QR { Q: arr, R: arr }

priv fn _qr_mat_zero(rows, cols) {
    let m = [];
    for i in 0..rows {
        let row = [];
        for j in 0..cols { push(row, 0); }
        push(m, row);
    }
    return m;
}

priv fn _qr_eye(n) {
    let I = _qr_mat_zero(n, n);
    for i in 0..n { I[i][i] = 1; }
    return I;
}

priv fn _qr_mat_copy(A) {
    let rows = len(A);
    let cols = len(A[0]);
    let out = _qr_mat_zero(rows, cols);
    for i in 0..rows {
        for j in 0..cols { out[i][j] = A[i][j]; }
    }
    return out;
}

pub fn qr_decompose(A_in) {
    let m = len(A_in);
    if (m == 0) { throw "qr_decompose: empty matrix"; }
    let n = len(A_in[0]);
    if (m < n) { throw "qr_decompose: require m >= n"; }
    let R = _qr_mat_copy(A_in);
    let Q = _qr_eye(m);
    // Walk down the diagonal. At step k, build a Householder vector that
    // zeros R[k+1..m, k]; apply it to R and accumulate it into Q.
    let cols = n;
    if (m - 1 < n) { cols = m - 1; }   // last column of square A doesn't need a reflector
    for k in 0..cols {
        // alpha = -sign(R[k][k]) * ||R[k..m, k]||
        let s = 0;
        for i in k..m { s = s + R[i][k] * R[i][k]; }
        let norm = sqrt(s);
        if (norm == 0) { continue; }   // already zero column — skip
        let sign = 1; if (R[k][k] < 0) { sign = -1; }
        let alpha = -sign * norm;
        // v = R[k..m, k] - alpha e_1
        let v = [];
        for i in 0..m - k { push(v, 0); }
        for i in k..m { v[i - k] = R[i][k]; }
        v[0] = v[0] - alpha;
        let vsq = 0;
        for i in 0..len(v) { vsq = vsq + v[i] * v[i]; }
        if (vsq == 0) { continue; }
        // Apply (I - 2 v v^T / v.v) to R from the left (rows k..m-1).
        for j in k..n {
            let dot = 0;
            for i in k..m { dot = dot + v[i - k] * R[i][j]; }
            let scale = 2 * dot / vsq;
            for i in k..m {
                R[i][j] = R[i][j] - scale * v[i - k];
            }
        }
        // Apply to Q from the right (or build Q^T column by column).
        // Cheapest is: Q := Q * H. H acts on columns k..m-1 of Q similarly.
        for i in 0..m {
            let dot = 0;
            for j in k..m { dot = dot + Q[i][j] * v[j - k]; }
            let scale = 2 * dot / vsq;
            for j in k..m {
                Q[i][j] = Q[i][j] - scale * v[j - k];
            }
        }
    }
    return QR(Q, R);
}

// Compute Q^T b without forming Q explicitly (well — we have Q, so just
// use it). Cheap convenience for the solve path.
pub fn qr_apply_QT(qr, b) {
    let Q = qr.Q;
    let m = len(Q);
    let out = [];
    for j in 0..m {
        let s = 0;
        for i in 0..m { s = s + Q[i][j] * b[i]; }
        push(out, s);
    }
    return out;
}

// Solve A x = b in least-squares sense via the QR factorization. For
// m == n this is an exact solve; for m > n it returns the LS solution.
pub fn qr_solve(qr, b) {
    let R = qr.R;
    let m = len(R);
    let n = len(R[0]);
    let QTb = qr_apply_QT(qr, b);
    // Back-substitute on the upper n x n block.
    let x = [];
    for i in 0..n { push(x, 0); }
    for (let i = n - 1; i >= 0; i = i - 1) {
        let s = QTb[i];
        for j in i + 1..n { s = s - R[i][j] * x[j]; }
        if (R[i][i] == 0) { throw "qr_solve: rank deficient"; }
        x[i] = s / R[i][i];
    }
    return x;
}
